# Uploaded files are data, never code.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phps .cgi .pl .py .asp .aspx .jsp .sh
RemoveType .php .phtml .php3 .php4 .php5 .php7 .phps
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php8.c>
  php_flag engine off
</IfModule>
<FilesMatch "\.(?i:php\d?|phtml|phar|pht|cgi|pl|py|asp|aspx|jsp|sh|svg|html?|js)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'none'; script-src 'none'"
</IfModule>

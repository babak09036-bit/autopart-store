APP_ENV=production
APP_DEBUG=false
# Full public URL of the site (path included when served from a sub-folder, e.g. http://localhost/auto)
APP_URL=https://example.com
APP_KEY=generate-a-random-64-char-hex-string

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=autopart
DB_USERNAME=autopart
DB_PASSWORD=change-me

# true on HTTPS (sets the Secure flag on cookies)
SESSION_SECURE=true

# Sandbox payments that never move money. Must be false in production.
PAYMENT_TEST_MODE=false

# Only "log" is bundled (writes mails to storage/logs/mail-*.log)
MAIL_DRIVER=log
MAIL_FROM=no-reply@example.com

# One-time first-admin page (/setup.php). Set a random value of 32+ characters only while creating
# the first administrator, then delete this line. Generate one with:
#   php -r "echo bin2hex(random_bytes(24)), PHP_EOL;"
SETUP_TOKEN=
